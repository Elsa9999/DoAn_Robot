<?xml version="1.0" ?>
<robot name="ur5e_robot">
  <link name="base_link"/>
  <link name="base_link_inertia">
    <visual>
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
      <geometry><mesh filename="ur5e/visual/base.dae"/></geometry>
    </visual>
    <collision>
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
      <geometry><mesh filename="ur5e/collision/base.stl"/></geometry>
    </collision>
  </link>
  <joint name="base_link-base_link_inertia" type="fixed">
    <parent link="base_link"/><child link="base_link_inertia"/>
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
  </joint>

  <link name="shoulder_link">
    <visual>
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
      <geometry><mesh filename="ur5e/visual/shoulder.dae"/></geometry>
    </visual>
    <collision>
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
      <geometry><mesh filename="ur5e/collision/shoulder.stl"/></geometry>
    </collision>
  </link>
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link_inertia"/><child link="shoulder_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.1625"/>
    <axis xyz="0 0 1"/><limit effort="150.0" lower="-6.28" upper="6.28" velocity="3.14"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <origin rpy="1.570796 0 -1.570796" xyz="0 0 0.138"/>
      <geometry><mesh filename="ur5e/visual/upperarm.dae"/></geometry>
    </visual>
    <collision>
      <origin rpy="1.570796 0 -1.570796" xyz="0 0 0.138"/>
      <geometry><mesh filename="ur5e/collision/upperarm.stl"/></geometry>
    </collision>
  </link>
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/><child link="upper_arm_link"/>
    <origin rpy="1.570796 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/><limit effort="150.0" lower="-6.28" upper="6.28" velocity="3.14"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <origin rpy="1.570796 0 -1.570796" xyz="0 0 0.007"/>
      <geometry><mesh filename="ur5e/visual/forearm.dae"/></geometry>
    </visual>
    <collision>
      <origin rpy="1.570796 0 -1.570796" xyz="0 0 0.007"/>
      <geometry><mesh filename="ur5e/collision/forearm.stl"/></geometry>
    </collision>
  </link>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/><child link="forearm_link"/>
    <origin rpy="0 0 0" xyz="-0.425 0 0"/>
    <axis xyz="0 0 1"/><limit effort="150.0" lower="-3.14" upper="3.14" velocity="3.14"/>
  </joint>

  <link name="wrist_1_link">
    <visual>
      <origin rpy="1.570796 0 0" xyz="0 0 -0.127"/>
      <geometry><mesh filename="ur5e/visual/wrist1.dae"/></geometry>
    </visual>
    <collision>
      <origin rpy="1.570796 0 0" xyz="0 0 -0.127"/>
      <geometry><mesh filename="ur5e/collision/wrist1.stl"/></geometry>
    </collision>
  </link>
  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/><child link="wrist_1_link"/>
    <origin rpy="0 0 0" xyz="-0.3922 0 0.1333"/>
    <axis xyz="0 0 1"/><limit effort="28.0" lower="-6.28" upper="6.28" velocity="3.14"/>
  </joint>

  <link name="wrist_2_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.0997"/>
      <geometry><mesh filename="ur5e/visual/wrist2.dae"/></geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.0997"/>
      <geometry><mesh filename="ur5e/collision/wrist2.stl"/></geometry>
    </collision>
  </link>
  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/><child link="wrist_2_link"/>
    <origin rpy="1.570796 0 0" xyz="0 -0.0997 0"/>
    <axis xyz="0 0 1"/><limit effort="28.0" lower="-6.28" upper="6.28" velocity="3.14"/>
  </joint>

  <link name="wrist_3_link">
    <visual>
      <origin rpy="1.570796 0 0" xyz="0 0 -0.0989"/>
      <geometry><mesh filename="ur5e/visual/wrist3.dae"/></geometry>
    </visual>
    <collision>
      <origin rpy="1.570796 0 0" xyz="0 0 -0.0989"/>
      <geometry><mesh filename="ur5e/collision/wrist3.stl"/></geometry>
    </collision>
  </link>
  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/><child link="wrist_3_link"/>
    <origin rpy="1.570796 3.14159 3.14159" xyz="0 0.0996 0"/>
    <axis xyz="0 0 1"/><limit effort="28.0" lower="-6.28" upper="6.28" velocity="3.14"/>
  </joint>

  <link name="base"/><joint name="base_link-base_fixed_joint" type="fixed">
    <origin rpy="0 0 3.14159" xyz="0 0 0"/><parent link="base_link"/><child link="base"/></joint>
  <link name="flange"/><joint name="wrist_3-flange" type="fixed">
    <parent link="wrist_3_link"/><child link="flange"/><origin rpy="0 -1.57079 -1.57079" xyz="0 0 0"/></joint>
  <link name="tool0"/><joint name="flange-tool0" type="fixed">
    <origin rpy="1.57079 0 1.57079" xyz="0 0 0"/><parent link="flange"/><child link="tool0"/></joint>
</robot>